# Copy to .env.local and fill in. Never commit real values.

# Formspree form endpoint, e.g. https://formspree.io/f/xxxxxxxx  (https://formspree.io)
VITE_FORMSPREE_ENDPOINT=

# Public site URL (used for canonical / OG tags at runtime). No trailing slash.
VITE_SITE_URL=https://shahrulnizam-portfolio.vercel.app
